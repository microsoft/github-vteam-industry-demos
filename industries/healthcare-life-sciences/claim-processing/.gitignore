# Squad: ignore runtime state (logs, inbox, sessions)
# Note: .squad/casting/* is identity and MUST be committed to main, not ignored
.squad/orchestration-log/
.squad/log/
.squad/decisions/inbox/
.squad/sessions/
.squad/.scratch/
.squad/.cache/
# Squad: SubSquad activation file (local to this machine)
.squad-workstream

# Secrets & local config — never commit (Seraph: security)
.env
.env.*
!.env.example
appsettings.*.local.json
*.pfx
*.key

# .NET build output
[Bb]in/
[Oo]bj/
*.user

# Azure
.azure/

# Python venv for Foundry workflow scripts
.venv-foundry/
