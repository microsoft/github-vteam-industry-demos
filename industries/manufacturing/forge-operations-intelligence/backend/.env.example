# Configuration reference only. The application never reads .env files.
# Deployment normally uses the verified infra/phase1-config.json, copied into the image.
# Set environment variables to override these names. Never add client secrets.
AZURE_CREDENTIAL_MODE=managed_identity
AZURE_CLIENT_ID=<existing-user-assigned-identity-client-id>
AZURE_TENANT_ID=<existing-tenant-id>
# Image default; writable by UID 10001. Local development defaults to data\manufacturing.db.
# Refresh-safe local demo database; container restart/replacement may reset data and AI budget.
SQLITE_PATH=/app/data/manufacturing.db
FOUNDRY_PROJECT_ENDPOINT=https://<existing-foundry>.services.ai.azure.com/api/projects/<existing-project>
FOUNDRY_MODEL_DEPLOYMENT=manufacturing-mini-01
DOWNTIME_AGENT_NAME=downtime-investigation-agent
DOWNTIME_AGENT_ID=downtime-investigation-agent:1
DOWNTIME_AGENT_VERSION=1
MAINTENANCE_AGENT_NAME=maintenance-advisor-agent
MAINTENANCE_AGENT_ID=maintenance-advisor-agent:1
MAINTENANCE_AGENT_VERSION=1
