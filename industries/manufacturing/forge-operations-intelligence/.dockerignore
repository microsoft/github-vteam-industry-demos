# Deny by default: cloud builds receive only app sources and the two runtime contracts.
**
!Dockerfile
!.dockerignore
!backend/
!backend/*.py
!backend/requirements.txt
!frontend/
!frontend/package.json
!frontend/package-lock.json
!frontend/index.html
!frontend/tsconfig*.json
!frontend/vite.config.ts
!frontend/src/
!frontend/src/**
!infra/
!infra/agents.json
!infra/phase1-config.json
**/.env
**/.env.*
**/*.pem
**/*.key
**/node_modules
**/dist
**/__pycache__
**/.pytest_cache
**/*.pyc
**/*.tsbuildinfo
**/*.db*
**/*.sqlite*
**/data
.build-cache
.git
.github
.squad
.copilot
.vscode
.mcp.json
