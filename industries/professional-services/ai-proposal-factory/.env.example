# Local mode works without Azure configuration.
PORT=8000
AIPF_DEMO_MODE=true
AIPF_DATA_PATH=data/runtime/store.json

# Set these values for managed Azure persistence and retrieval.
AZURE_CLIENT_ID=
AZURE_LOCATION=swedencentral
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_BLOB_ENDPOINT=
AZURE_STORAGE_TABLE_ENDPOINT=
AZURE_AI_SEARCH_ENDPOINT=
AZURE_AI_SEARCH_INDEX_NAME=aipf-knowledge

# Set AIPF_DEMO_MODE=false and configure all Foundry values for live agents.
AZURE_AI_FOUNDRY_PROJECT_ENDPOINT=
AZURE_AI_MODEL_DEPLOYMENT_NAME=
AIPF_REQUIREMENTS_AGENT_ID=
AIPF_PROPOSAL_AGENT_ID=
AIPF_RISK_AGENT_ID=
