# API
PORT=3001
HOST=127.0.0.1
NODE_ENV=development
AUTH_MODE=development
# Exact browser origins accepted only in explicit development mode.
AUTH_DEVELOPMENT_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Explicit development principal only; never use development auth in production.
# Azure runtime supplies AUTH_MODE=entra, NODE_ENV=production, and the following:
# AUTH_TRUSTED_PROXY=container-apps
# AUTH_TENANT_ID=<detected-directory-uuid>
# AUTH_CLIENT_ID=<dedicated-Entra-web-app-registration-uuid>
# AUTH_PUBLIC_ORIGIN=https://<container-app-fqdn>
# Deployment tooling uses the same non-secret registration ID:
# AIPF_ENTRA_CLIENT_ID=<dedicated-Entra-web-app-registration-uuid>
# Assign ProposalFactory.WorkspaceMember to intended users or a security-enabled group.
DATA_PROVIDER=local
LOCAL_DATA_FILE=.data/proposal-factory.json
LOCAL_UPLOAD_DIRECTORY=.data/uploads
DOCUMENT_UPLOAD_MAX_BYTES=10485760
DOCUMENT_EXTRACTED_TEXT_MAX_CHARACTERS=40000

# Shared Azure region baseline
AZURE_LOCATION=swedencentral
AZURE_REGION_CODE=swc
AZURE_RESOURCE_GROUP=rg-aipf-dev-swc-001

# Managed Identity endpoints supplied by Platform
AZURE_STORAGE_BLOB_ENDPOINT=
AZURE_STORAGE_QUEUE_ENDPOINT=
AZURE_COSMOS_ENDPOINT=
AZURE_SEARCH_ENDPOINT=
AZURE_OPENAI_ENDPOINT=

# Azure data names
AZURE_COSMOS_DATABASE=proposal-factory
AZURE_COSMOS_OPPORTUNITIES_CONTAINER=opportunities
AZURE_COSMOS_DOCUMENTS_CONTAINER=documents
AZURE_COSMOS_CONTENT_CONTAINER=reusable-content
AZURE_COSMOS_PROPOSALS_CONTAINER=proposals
AZURE_COSMOS_GENERATION_RUNS_CONTAINER=generation-runs
AZURE_COSMOS_EXPORTS_CONTAINER=exports
AZURE_COSMOS_AUDIT_CONTAINER=audit-events
AZURE_BLOB_UPLOADS_CONTAINER=uploaded-documents
AZURE_BLOB_CONTENT_CONTAINER=reusable-content
AZURE_BLOB_EXPORTS_CONTAINER=generated-exports
AZURE_QUEUE_NAME=proposal-jobs
AZURE_POISON_QUEUE_NAME=proposal-jobs-poison
AZURE_QUEUE_VISIBILITY_TIMEOUT_SECONDS=60
AZURE_QUEUE_MAX_DEQUEUE_COUNT=5
AZURE_SEARCH_INDEX=proposal-knowledge-v1

# Intelligence-owned Azure OpenAI deployment settings
AI_PROVIDER=fixture
AZURE_OPENAI_GENERATION_DEPLOYMENT=proposal-chat
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=proposal-embeddings
AZURE_OPENAI_API_VERSION=v1
AZURE_SEARCH_API_VERSION=2025-09-01
# Optional user-assigned managed identity client UUID (not a secret)
AZURE_CLIENT_ID=
AI_EMBEDDINGS_ENABLED=true
AI_EMBEDDING_DIMENSIONS=3072
AI_RETRIEVAL_TOP_K=8
AI_VECTOR_K=30
AI_CONTEXT_TOKENS=64000
AI_MAX_INPUT_TOKENS=40000
AI_MAX_OUTPUT_TOKENS=16000
AI_REQUEST_TIMEOUT_MS=120000
AI_MAX_RETRIES=3
AI_RETRY_BASE_MS=500
AI_RETRY_MAX_MS=30000
