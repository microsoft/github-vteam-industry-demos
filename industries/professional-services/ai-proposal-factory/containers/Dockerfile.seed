# syntax=docker/dockerfile:1.7

ARG NODE_IMAGE=node:24.20.0-bookworm-slim

FROM ${NODE_IMAGE} AS build
WORKDIR /workspace
COPY package.json package-lock.json .npmrc ./
COPY apps ./apps
COPY packages ./packages
COPY containers ./containers
COPY tsconfig.base.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
RUN npx tsup --config containers/seed.tsup.config.ts

FROM ${NODE_IMAGE} AS production-dependencies
WORKDIR /workspace
COPY package.json package-lock.json .npmrc ./
COPY apps ./apps
COPY packages ./packages
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund \
    && npm cache clean --force

FROM ${NODE_IMAGE} AS runtime-base
ENV NODE_ENV=production \
    HOME=/tmp \
    TMPDIR=/tmp
WORKDIR /app
RUN apt-get update \
    && apt-get install --yes --no-install-recommends dumb-init \
    && rm -rf /var/lib/apt/lists/*
COPY --from=production-dependencies --chown=node:node /workspace/node_modules ./node_modules
COPY --from=build --chown=node:node /workspace/containers/dist ./containers/dist
USER node

FROM runtime-base AS verification
RUN node -e "Promise.all([import('@azure/identity'),import('@azure/cosmos'),import('@azure/storage-blob'),import('@azure/storage-queue'),import('@azure/search-documents'),import('openai'),import('zod'),import('marked'),import('playwright-core'),import('mammoth'),import('pdfjs-dist/legacy/build/pdf.mjs')]).then(() => console.log('External runtime dependencies available.'))"
RUN node containers/dist/seed-entrypoint.js --help | grep -F -- "--dry-run"
RUN DATA_PROVIDER=azure \
    AI_PROVIDER=azure \
    AZURE_LOCATION=swedencentral \
    AZURE_REGION_CODE=swc \
    AZURE_RESOURCE_GROUP=rg-aipf-dev-swc-001 \
    AZURE_COSMOS_ENDPOINT=https://dryrun.documents.azure.com \
    AZURE_STORAGE_BLOB_ENDPOINT=https://dryrun.blob.core.windows.net \
    AZURE_STORAGE_QUEUE_ENDPOINT=https://dryrun.queue.core.windows.net \
    AZURE_SEARCH_ENDPOINT=https://dryrun.search.windows.net \
    AZURE_OPENAI_ENDPOINT=https://dryrun.openai.azure.com \
    AZURE_CLIENT_ID=11111111-2222-3333-4444-555555555555 \
    node containers/dist/seed-entrypoint.js --dry-run | grep -F "Dry run complete"
RUN touch /tmp/seed-verification-ok

FROM runtime-base AS runtime
ARG BUILD_VERSION
LABEL org.opencontainers.image.title="AI Proposal Factory Seeder" \
      org.opencontainers.image.version="${BUILD_VERSION}"
RUN test -n "${BUILD_VERSION}" && test "${BUILD_VERSION}" != "latest"
COPY --from=verification /tmp/seed-verification-ok /opt/container-verification/seed
STOPSIGNAL SIGTERM
ENTRYPOINT ["dumb-init", "--", "node", "containers/dist/seed-entrypoint.js"]
CMD []
