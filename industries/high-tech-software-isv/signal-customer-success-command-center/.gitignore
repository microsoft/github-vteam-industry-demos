# Squad: ignore runtime state (logs, inbox, sessions)
# Note: .squad/casting/* is identity and MUST be committed to main, not ignored
.squad/orchestration-log/
.squad/log/
.squad/decisions/inbox/
.squad/sessions/
.squad/.scratch/
.squad/.cache/
# Squad: SubSquad activation file (local to this machine)
.squad-workstream

# Application dependencies, build outputs and strictly local ephemeral state
.venv/
frontend/node_modules/
frontend/dist/
__pycache__/
*.pyc
*.sqlite
*.sqlite3
*.sqlite3-*
*.sqlite-*
*.db
.local-data/
.local-validation/
.env
.env.*
!.env.example
