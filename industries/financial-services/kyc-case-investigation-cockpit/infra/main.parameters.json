{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION=swedencentral}"
    },
    "deploymentPrincipalId": {
      "value": "${AZURE_PRINCIPAL_ID}"
    },
    "modelDeploymentName": {
      "value": "${AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5-1-kyc}"
    },
    "modelName": {
      "value": "${AZURE_AI_MODEL_NAME=gpt-5.1}"
    },
    "modelVersion": {
      "value": "${AZURE_AI_MODEL_VERSION=2025-11-13}"
    },
    "modelCapacity": {
      "value": "${AZURE_AI_MODEL_CAPACITY=3}"
    },
    "extractAgentName": {
      "value": "${FOUNDRY_AGENT_EXTRACT=agt-kyc-extract}"
    },
    "completeAgentName": {
      "value": "${FOUNDRY_AGENT_COMPLETE=agt-kyc-complete}"
    },
    "riskAgentName": {
      "value": "${FOUNDRY_AGENT_RISK=agt-kyc-risk}"
    },
    "summaryAgentName": {
      "value": "${FOUNDRY_AGENT_SUMMARY=agt-kyc-summary}"
    }
  }
}
